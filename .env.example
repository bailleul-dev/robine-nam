# Copy to .env (git-ignored). Loaded by the Makefile and by
# scripts/download_assets.py. The library and nam-lab never read it.
# Values must not be quoted.

# TONE3000 publishable key (t3k_pub_...), from https://www.tone3000.com/settings
# Used for the OAuth device flow when downloading A2 captures.
TONE3000_CLIENT_ID=

# Optional: a ready-made access token; skips the device flow when set.
TONE3000_ACCESS_TOKEN=

# Optional: where downloaded test assets go (default: ./assets).
ROBINE_NAM_ASSETS_DIR=
